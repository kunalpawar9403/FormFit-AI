{
  "name": "formfit-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run backend:dev & npm run frontend:dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:test": "npm --prefix backend run test",
    "build": "npm run frontend:build",
    "test": "node --test tests/*.test.js",
    "install:all": "npm --prefix frontend install && npm --prefix backend install"
  }
}
